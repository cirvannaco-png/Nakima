# Image the SandboxExecutor runs generated code inside for validation.
# Covers every language in execution/tool_registry.py's matrix.
# Network-disabled at container-run time (see execution/sandbox.py); this
# image is intentionally not slim, since it needs real toolchains, not
# just interpreters.
FROM python:3.12-slim

# Python toolchain — pin to exact versions for reproducible sandbox
# security posture; bump here when CVEs surface in these tools.
RUN pip install --no-cache-dir \
    black==25.1.0 \
    flake8==7.2.0 \
    pytest==8.3.5 \
    pytest-cov==6.1.0 \
    bandit==1.8.5 \
    safety==3.5.1

# Node/JS/TS toolchain
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g prettier eslint typescript \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Go toolchain — install Go, set GOPATH to a system-owned dir so all
# subsequently installed tools land in /usr/local/go-tools/bin, which is
# added to PATH before the user switch so the non-root sandbox user can
# reach them.
ENV GOROOT="/usr/local/go"
ENV GOPATH="/usr/local/go-tools"
ENV PATH="/usr/local/go/bin:/usr/local/go-tools/bin:${PATH}"

RUN curl -fsSL https://go.dev/dl/go1.22.5.linux-amd64.tar.gz -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && mkdir -p /usr/local/go-tools \
    && go install golang.org/x/lint/golint@latest 2>/dev/null || true \
    && go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest || true \
    && go install github.com/securego/gosec/v2/cmd/gosec@latest || true \
    && chmod -R 755 /usr/local/go-tools

# Security: run as non-root inside sandbox too
RUN groupadd --gid 1001 sandbox && \
    useradd --uid 1001 --gid sandbox --no-create-home sandbox

WORKDIR /workspace
USER sandbox
