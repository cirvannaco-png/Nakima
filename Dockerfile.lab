# Dedicated Lab executor. This is not the general SandboxExecutor image.
# The trusted host launches it with network_mode=none, a read-only archive
# bind mount, read-only rootfs, tmpfs workspace/output, and minimal caps.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/nakima

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Only tools needed by the controller and its initial Python test runner.
# Target-repository dependencies are not installed from the network.
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
       httpx==0.28.1 \
       pydantic==2.12.5 \
       pytest==9.0.3

RUN groupadd --gid 10001 labrunner \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin labrunner \
    && mkdir -p /opt/nakima/lab /input /workspace /output \
    && chown root:root /input /output \
    && chmod 0700 /output

COPY lab/__init__.py /opt/nakima/lab/__init__.py
COPY lab/source_bundle.py /opt/nakima/lab/source_bundle.py
COPY lab/result_contract.py /opt/nakima/lab/result_contract.py
COPY orchestrator/self_healing.py /opt/nakima/self_healing.py
COPY sandbox_image/entrypoint.py /opt/nakima/entrypoint.py

WORKDIR /workspace
# Docker's trusted host overrides this to root with only CHOWN/SETUID/SETGID
# capabilities. All repository test commands are then demoted to UID/GID 10001.
USER 10001:10001
ENTRYPOINT ["python3", "/opt/nakima/entrypoint.py"]
