# --- GitHub App (issue -> PR automation) ---
# Create the App at https://github.com/settings/apps/new
GITHUB_APP_ID=
# Either paste the raw .pem contents here (escape newlines as \n) or,
# easier, leave this blank and set GITHUB_PRIVATE_KEY_PATH instead.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=./nakima-app.private-key.pem
# Set when you configure the webhook on the App's settings page.
GITHUB_WEBHOOK_SECRET=

# --- AI Provider ---
# Default provider is GitHub Models (free, OpenAI-compatible endpoint auth'd
# with a normal GitHub PAT). Create a fine-grained token with the
# "Models: read" permission at:
#   https://github.com/settings/personal-access-tokens/new
# and paste it below. Inside GitHub Actions you can reuse the built-in
# ${{ secrets.GITHUB_TOKEN }} with `permissions: models: read`.
DEFAULT_AI_PROVIDER=github
GITHUB_TOKEN=
# Optional: override the model. See https://github.com/marketplace/models
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Optional paid providers (only needed if you set DEFAULT_AI_PROVIDER to one of them)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Database / Redis (defaults match docker-compose.yml) ---
DB_HOST=db
DB_PORT=5432
DB_USER=nakima
DB_PASSWORD=nakima
DB_NAME=nakima
REDIS_HOST=redis
REDIS_PORT=6379

ENVIRONMENT=development

# --- Logging ---
# json (default, structured) or text (dev-friendly)
LOG_FORMAT=json
