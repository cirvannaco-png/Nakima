# ─── Nakima environment variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values before running locally.
# In production (Cloud Run, Render, etc.) set these as platform secrets —
# never commit a populated .env to source control.

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production          # development | production
LOG_FORMAT=json                 # json (structured) | text (human-readable)

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Supply DATABASE_URL directly, or let the app build it from the parts below.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nakima
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=nakima
# DB_PASSWORD=changeme
# DB_NAME=nakima
# DB_POOL_SIZE=20

# ─── AI provider (pick ONE) ───────────────────────────────────────────────────
# The app starts without any of these, but AI-backed features (code analysis,
# security scanning, task orchestration) will be unavailable until one is set.

DEFAULT_AI_PROVIDER=github      # github | openai | claude | deepseek

# GitHub Models (free — uses a GitHub PAT with "Models: read" scope)
# Create at: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=ghp_...

# Alternatively, use a dedicated models token to separate inference from
# repo automation:
# GITHUB_MODELS_TOKEN=ghp_...
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Optional paid providers (only needed if DEFAULT_AI_PROVIDER matches)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...

# ─── GitHub App (webhook + PR automation) ─────────────────────────────────────
# All three must be set together, or all left unset.
# Create a GitHub App at: https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-private-key.pem
# Or inline the PEM (newlines as \n):
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=a-random-secret-string

# ─── Virus scanning (optional) ────────────────────────────────────────────────
# Leave unset to skip virus scanning. Set CLAMD_HOST to enable ClamAV.
# See security/virus_scanner.py for deployment steps.
# CLAMD_HOST=localhost
# CLAMD_PORT=3310
# CLAMD_TIMEOUT_SECONDS=15.0

# ─── Execution sandbox ────────────────────────────────────────────────────────
# Docker image used by SandboxExecutor for running validation tools.
# Build with: docker build -f Dockerfile.sandbox -t nakima-sandbox:latest .
SANDBOX_IMAGE=nakima-sandbox:latest

# ─── Market research (optional) ───────────────────────────────────────────────
# Leave unset to skip external research scans entirely — the Research Agent
# will run and report zero signals found rather than error. No backend is
# chosen by default; set MARKET_RESEARCH_SEARCH_API_KEY once you've picked
# one. See market_research/search.py for the SearchClient interface if you
# want to wire up something other than Brave Search.
# MARKET_RESEARCH_SEARCH_API_KEY=
# MARKET_RESEARCH_HTTP_TIMEOUT=8.0
# MARKET_RESEARCH_MAX_RESULTS_PER_QUERY=8
# MARKET_RESEARCH_MAX_OPPORTUNITIES_PER_RUN=5
