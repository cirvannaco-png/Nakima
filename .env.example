# --- GitHub App ---
# Create the App at https://github.com/settings/apps/new
GITHUB_APP_ID=
# Either paste the raw .pem contents here (escape newlines as \n) or,
# easier, leave this blank and set GITHUB_PRIVATE_KEY_PATH instead.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=./nakima-app.private-key.pem
# Set when you configure the webhook on the App's settings page.
GITHUB_WEBHOOK_SECRET=

# --- AI Provider ---
DEFAULT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- Database / Redis (defaults match docker-compose.yml) ---
DB_HOST=db
DB_PORT=5432
DB_USER=nakima
DB_PASSWORD=nakima
DB_NAME=nakima
REDIS_HOST=redis
REDIS_PORT=6379

ENVIRONMENT=development
