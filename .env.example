# Copy to `.env` and fill in real values. Never commit `.env`.

# --- App ---
ENVIRONMENT=development           # development | staging | production
APP_NAME=nakima
VERSION=1.0.0
LOG_LEVEL=INFO

# --- Database (defaults match docker-compose.yml) ---
DB_HOST=db
DB_PORT=5432
DB_USER=nakima
DB_PASSWORD=nakima
DB_NAME=nakima
DB_POOL_SIZE=20
# Optional: fully-formed URL overrides the DB_* fields above.
# DATABASE_URL=postgresql+asyncpg://nakima:nakima@db:5432/nakima

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# --- GitHub App (https://github.com/settings/apps/new) ---
GITHUB_APP_ID=
# Provide EITHER the raw PEM contents (escape newlines as \n) OR a path:
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=./nakima-app.private-key.pem
# Set the same value in the GitHub App webhook settings.
GITHUB_WEBHOOK_SECRET=

# --- AI Providers ---
DEFAULT_AI_PROVIDER=claude        # claude | openai | deepseek
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT=300
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Execution / Sandbox ---
EXECUTION_MAX_RETRIES=2
TEST_TIMEOUT=600
BUILD_TIMEOUT=1200
SANDBOX_IMAGE=nakima-sandbox:latest

# --- Security ---
SCAN_ON_PR=true
SECRET_DETECTION=true
